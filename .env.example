# Optional settings. No secrets are needed: the tool runs fully offline.
# Export these in your shell (the tool reads the environment, it does not load this file).

# Country code added to 10 digit phone numbers.
CRM_KIT_DEFAULT_COUNTRY_CODE=1

# How alike two names must be (0 to 1) before records sharing a phone are merged.
CRM_KIT_NAME_SIMILARITY=0.82
